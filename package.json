{
  "name": "gil-elements-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "tsc -p packages/base --noEmit && tsc -p packages/elements --noEmit",
    "test": "vitest --run",
    "size": "node scripts/size.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run size"
  },
  "devDependencies": {
    "@lit-labs/ssr": "^4.1.0",
    "@tailwindcss/cli": "^4.3.3",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "axe-core": "^4.14.0",
    "lit": "^3.3.3",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
